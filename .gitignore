# 字节码 / 缓存
__pycache__/
*.py[cod]
*.pyo
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 虚拟环境
.venv/
venv/
env/

# 构建产物
build/
dist/
*.egg-info/
# 图标与版本资源都由 build.py 从源码现算, 不入库
build_assets/*.ico
build_assets/version_info.txt

# 开发期临时文件 (下划线开头的脚本/文本)
_shots/
_scratch_*.py
_*.py
# 例外: __init__.py 也以 "_" 开头, 但它必须入库 (否则包里根本没有 __init__)
!__init__.py
_*.txt
*.cmdb.tmp-*
*.cmj.tmp-*

# 用户数据 (示例)
*.cmdb.[0-9]
